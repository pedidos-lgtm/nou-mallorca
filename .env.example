# Copiar a .env o exportar; sin credenciales reales
APP_ENV=development
APP_URL=http://127.0.0.1:8000
DATA_DIR=.data
COOKIE_SECURE=false
SIGNATURE_ADAPTER=test
MAIL_ADAPTER=test
MAX_UPLOAD_MB=15
# La V1 usa SQLite y disco privado. PostgreSQL/S3 no están implementados.
# Solo para backup/restore; suministrar desde un gestor seguro.
# BACKUP_KEY=
# Alta inicial automatizada, solo en base vacía (Render: usar variables seguras).
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
